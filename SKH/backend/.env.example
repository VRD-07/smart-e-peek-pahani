TWILIO_AUTH_TOKEN=
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
NODE_ENV=development
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outbound WhatsApp notifications (deadline reminders, awareness intros) ---
# 'mock' prints messages to the console and sends nothing. Switch to 'twilio'
# with WhatsApp *sandbox* credentials to send for real; the recipient must have
# joined the sandbox from their handset first. A production WhatsApp Business
# sender additionally requires Meta business verification and approved message
# templates, which is an external approval process.
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_NUMBER=
# Daily awareness sweep schedule (5-field cron). Defaults to 08:00.
AWARENESS_CRON=0 8 * * *

# Password used by scripts/seedDemoOfficer.js (defaults to demo1234)
OFFICER_DEMO_PASSWORD=

# --- Marathi / Hindi / English voice entry for the crop step ---
# 'mock' returns fixed transcripts keyed off the media URL, so the whole voice
# flow — including the low-confidence fallback — is demoable with no API key.
# 'gemini' transcribes for real using the GEMINI_API_KEY above; no extra
# credential and no extra dependency, since the SDK is already here for crop
# image classification.
STT_PROVIDER=mock
# Below this confidence the transcript is not accepted as a crop declaration and
# the farmer is asked to type the name instead. Defaults to 0.70.
STT_MIN_CONFIDENCE=0.70

# --- Boundary-edge review routing ---
# A submission inside the Gat but within this many metres of its edge is sent to
# human review instead of auto-approved, because consumer GPS error at that scale
# is indistinguishable from standing in the next field. Also capped at half the
# parcel's own half-width at runtime, so a small plot is not put entirely under
# review. Set to 0 to disable the check. Defaults to 15.
NEAR_BOUNDARY_THRESHOLD_METERS=15

# --- Multi-channel escalation: WhatsApp -> SMS -> voice call ---
# Same Twilio account as the bot, but each channel needs its own sender: the
# WhatsApp sandbox number can neither send SMS nor place calls. Leaving either
# unset disables that rung (it reports SENDER_NOT_CONFIGURED and the ladder moves
# on) rather than breaking the notification.
TWILIO_SMS_NUMBER=
TWILIO_VOICE_NUMBER=
# Publicly reachable base URL that serves assets/voice/. Twilio fetches the audio
# itself, so a localhost URL will not work — use a tunnel (ngrok) for local demos.
# The committed .wav files are placeholder tones, NOT Marathi speech; see
# assets/voice/README.md. Unset falls back to <Say>, for which no Marathi voice
# exists, so the call would be read out in Hindi.
VOICE_AUDIO_BASE_URL=
# Hours to wait for a delivery confirmation on a channel before escalating to the
# next one. Set both to 0 to walk the whole ladder in a single sweep, which is how
# the demo panel shows all three channels without waiting two days.
ESCALATION_WHATSAPP_WINDOW_HOURS=24
ESCALATION_SMS_WINDOW_HOURS=24
# Whether a WhatsApp message has to be *read*, not merely delivered, to count as
# reaching the farmer. true is the stricter reading and the default; the cost is
# that farmers who turn read receipts off never report 'read' and so are always
# escalated to SMS and then to a call. Set false to accept 'delivered'.
ESCALATION_WHATSAPP_REQUIRE_READ=true
